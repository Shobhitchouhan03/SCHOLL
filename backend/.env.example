# ==================================================
# BACKEND PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==================================================

NODE_ENV=production
PORT=5000

# Database Connection (MongoDB Atlas)
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@cluster0.mongodb.net/school_saas?retryWrites=true&w=majority

# JWT Authentication Secrets (Generate secure 64-char random strings in production)
JWT_ACCESS_SECRET=YOUR_JWT_ACCESS_SECRET_MIN_32_CHARS
JWT_REFRESH_SECRET=YOUR_JWT_REFRESH_SECRET_MIN_32_CHARS
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Domain & CORS Configuration
CLIENT_URL=https://yourdomain.com
FRONTEND_URL=https://yourdomain.com
COOKIE_DOMAIN=yourdomain.com
ROOT_DOMAIN=yourdomain.com
PUBLIC_APP_URL=https://yourdomain.com

# Rate Limiting Settings
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=info
